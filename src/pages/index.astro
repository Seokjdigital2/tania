---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BuyButtons from '@/components/BuyButtons.astro';
import BlushBlob from '@/components/BlushBlob.astro';
import LeafSprig from '@/components/LeafSprig.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { site } from '@/config/site';
import { product, concerns, formatMXN } from '@/data/product';
import { faqs } from '@/data/faq';
import { reviews } from '@/data/reviews';
import heroImg from '@/assets/img/crema-tocador.jpg';
import viewsImg from '@/assets/img/crema-vistas.jpg';
import taniaBeach from '@/assets/img/tania-playa.jpg';
import taniaUrban from '@/assets/img/tania-urbana.jpg';

// TEXTOS PROVISIONALES: reemplazar con copy final (ver docs/TABLERO.md).
const description = `${site.name}: crema mexicana que ayuda a atenuar la apariencia de manchas en cara, axilas, codos y rodillas. ${product.priceMXN ? formatMXN(product.priceMXN) + '. ' : ''}Creada por Tania en Puerto Vallarta. Compra en Mercado Libre o TikTok Shop.`;
const price = product.priceMXN ? formatMXN(product.priceMXN) : null;
---

<BaseLayout title={`${site.name} · Crema para manchas en cara y cuerpo`} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-media">
        <BlushBlob class="hero-blob" />
        <LeafSprig class="hero-leaf hero-leaf--a" size={110} />
        <LeafSprig class="hero-leaf hero-leaf--b" size={78} flip />
        <div class="arch">
          <Image
            src={heroImg}
            alt="Tarro blanco de crema Beauty Organic sobre un tocador de mármol con flores rosas"
            widths={[420, 640, 900, 1254]}
            sizes="(min-width: 1000px) 540px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="hero-copy">
        <span class="eyebrow">Hecha en Puerto Vallarta</span>
        <h1>Crema para manchas <em>en cara y cuerpo</em></h1>
        <p class="lead">Un tono más uniforme y luminoso con una sola crema de uso diario, creada por Tania.</p>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza · envío a todo México</span>
            </p>
          )
        }
        <div id="comprar" data-sticky-trigger>
          <BuyButtons placement="hero" note />
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Tipos de manchas (editorial) -->
  <section class="section">
    <div class="container concerns">
      <div class="concerns-head">
        <span class="eyebrow">Tu piel, tu historia</span>
        <h2>¿Qué manchas <em>te preocupan?</em></h2>
        <p class="lead">Cada mancha tiene una causa distinta. Conócela para cuidarla mejor.</p>
        <a class="link-arrow" href="/manchas-en-la-piel/">Ver todas las guías →</a>
      </div>
      <ol class="concern-list">
        {
          concerns.map((c, i) => (
            <li>
              <a href={`/manchas-en-la-piel/${c.slug}/`}>
                <span class="n">0{i + 1}</span>
                <span class="c-body">
                  <span class="c-title">{c.title}</span>
                  <span class="c-text">{c.text}</span>
                </span>
                <span class="c-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Producto -->
  <section class="section section--ivory showcase" aria-labelledby="la-crema">
    <div class="container showcase-grid">
      <div class="showcase-media">
        <BlushBlob class="showcase-blob" />
        <Image
          src={viewsImg}
          alt="Tarro de crema Beauty Organic visto de frente, desde arriba y de lado"
          widths={[600, 900, 1230]}
          sizes="(min-width: 1000px) 640px, 92vw"
        />
        <p class="spec">Tarro de {product.container.diameterCm} cm × {product.container.heightCm} cm · {product.netContent || 'contenido por confirmar'}</p>
      </div>
      <div class="showcase-card">
        <span class="eyebrow">La crema</span>
        <h2 id="la-crema">{product.shortName}</h2>
        <p class="muted">{product.description}</p>
        <ul class="benefits">
          {
            product.benefits.map((b) => (
              <li>
                <span class="check" aria-hidden="true" />
                <span><strong>{b.title}.</strong> {b.text}</span>
              </li>
            ))
          }
        </ul>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza</span>
            </p>
          )
        }
        <div data-sticky-trigger><BuyButtons placement="showcase" class="buy--stack" /></div>
        <a class="link-arrow details" href="/crema-desmanchadora/">Ver detalles, ingredientes y modo de uso →</a>
      </div>
    </div>
  </section>

  <!-- Ritual -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">El ritual</span>
        <h2>Tres pasos, <em>todos los días</em></h2>
      </div>
      <ol class="ritual">
        {
          product.howToUse.map((s, n) => (
            <li>
              <span class="r-n">{n + 1}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Ingredientes -->
  <section class="section section--blush ingredients-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">La fórmula</span>
        <h2>Ingredientes que <em>cuidan tu piel</em></h2>
      </div>
      <div class="grid grid--3 ingredients">
        {
          product.keyIngredients.map((i, n) => (
            <div class="ingredient">
              <LeafSprig size={38} />
              <span class="num">0{n + 1}</span>
              <h3>{i.name}</h3>
              <p class="muted">{i.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tania -->
  <section class="section founder">
    <div class="container founder-grid">
      <div class="collage">
        <div class="ph ph--main">
          <Image
            src={taniaBeach}
            alt="Tania, fundadora de Beauty Organic, en una playa de Puerto Vallarta sosteniendo su crema"
            widths={[400, 600, 784]}
            sizes="(min-width: 1000px) 440px, 78vw"
          />
        </div>
        <div class="ph ph--small">
          <Image
            src={taniaUrban}
            alt="Tania sosteniendo un tarro de Beauty Organic"
            widths={[240, 400]}
            sizes="(min-width: 1000px) 220px, 40vw"
          />
        </div>
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Conoce a la fundadora</span>
        <h2>Hola, <em>soy Tania</em></h2>
        <p class="lead">
          Texto provisional: aquí Tania cuenta en dos o tres líneas por qué creó Beauty Organic y qué la hace diferente.
        </p>
        <p class="script">Belleza que realza tu esencia</p>
        <a class="link-arrow" href="/sobre-tania/">Lee mi historia →</a>
      </div>
    </div>
  </section>

  <!-- Antes y después: espacio reservado -->
  <section class="section section--ivory">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Resultados reales</span>
        <h2>Antes <em>y después</em></h2>
        <p class="lead">Aquí mostraremos fotos reales de clientas, con su permiso. Resultados individuales; pueden variar.</p>
      </div>
      <div class="grid grid--3 swipe">
        {
          [1, 2, 3].map((n) => (
            <div class="ba-placeholder" role="img" aria-label={`Espacio reservado para foto de antes y después ${n}`}>
              <span>Antes</span>
              <span>Después</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Opiniones</span>
        <h2>Lo que dicen <em>nuestras clientas</em></h2>
      </div>
      <div class="grid grid--3 swipe">
        {reviews.slice(0, 3).map((r) => <ReviewCard review={r} />)}
      </div>
      <p class="center more"><a class="link-arrow" href="/resenas/">Ver todas las reseñas →</a></p>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section section--ivory">
    <div class="container faq-grid">
      <div class="faq-head">
        <span class="eyebrow">Dudas</span>
        <h2>Preguntas <em>frecuentes</em></h2>
        <p class="muted">¿No encuentras tu respuesta? <a href="/preguntas-frecuentes/">Ver todas las preguntas</a>.</p>
      </div>
      <FaqAccordion items={faqs.slice(0, 6)} />
    </div>
  </section>

  <!-- Cierre -->
  <section class="section final">
    <div class="container final-grid">
      <div class="final-media">
        <BlushBlob class="final-blob" />
        <Image src={heroImg} alt="" widths={[360, 600]} sizes="(min-width: 1000px) 380px, 70vw" />
      </div>
      <div class="final-copy">
        <LeafSprig size={52} />
        <h2>Empieza hoy <em>tu ritual</em></h2>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza · envío a todo México</span>
            </p>
          )
        }
        <div data-sticky-trigger><BuyButtons placement="final" note /></div>
        <p class="muted local">
          ¿Estás en {site.delivery.area}? <a href="/entrega-puerto-vallarta/">Conoce la entrega local por motocicleta</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(24px, 5vw, 72px) clamp(48px, 7vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .hero h1 {
    max-width: 13ch;
  }
  .hero .lead {
    margin-bottom: 26px;
  }
  .hero-media {
    position: relative;
    width: 100%;
    max-width: 540px;
    justify-self: center;
  }
  .hero-media :global(.hero-blob) {
    position: absolute;
    inset: -6% -12% -6% -10%;
    width: 122%;
    height: 112%;
    z-index: -1;
  }
  .hero-media :global(.hero-leaf) {
    position: absolute;
    z-index: 2;
  }
  .hero-media :global(.hero-leaf--a) {
    top: 8%;
    left: -9%;
    transform: rotate(-18deg);
  }
  .hero-media :global(.hero-leaf--b) {
    bottom: 10%;
    right: -6%;
  }
  .arch {
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    aspect-ratio: 4 / 5;
  }
  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 999px) {
    /* En móvil: imagen compacta para que precio y botones queden en la primera pantalla. */
    .hero {
      padding-top: 16px;
    }
    .hero-grid {
      gap: 20px;
    }
    .hero-media {
      max-width: 300px;
    }
    .hero h1 {
      font-size: clamp(2.2rem, 9vw, 2.8rem);
      margin-bottom: 0.35em;
    }
    .hero .eyebrow {
      margin-bottom: 0.6rem;
    }
    .hero .lead {
      font-size: 1rem;
      margin-bottom: 14px;
    }
    .hero .price-tag {
      margin-bottom: 16px;
    }
    .hero-media :global(.hero-leaf--a) {
      width: 72px;
      left: -4%;
    }
    .hero-media :global(.hero-leaf--b) {
      width: 54px;
      right: -2%;
    }
    .arch {
      aspect-ratio: 5 / 4;
      border-radius: 999px 999px var(--radius) var(--radius);
    }
    .hero-copy {
      text-align: center;
    }
    .hero h1,
    .hero .lead {
      margin-inline: auto;
    }
    .hero .price-tag {
      justify-content: center;
    }
    .hero :global(.buy-note) {
      justify-content: center;
    }
  }
  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 96px;
    }
    .hero-media {
      order: 2;
    }
  }

  /* Manchas */
  .concerns {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .concerns {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 96px;
      align-items: start;
    }
    .concerns-head {
      position: sticky;
      top: 140px;
    }
  }
  .concern-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ob-line);
  }
  .concern-list li {
    border-bottom: 1px solid var(--ob-line);
  }
  .concern-list a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 28px 4px;
    text-decoration: none;
    transition: background-color 0.25s var(--ease);
  }
  .concern-list a:hover {
    background: var(--ob-ivory);
  }
  .n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ob-leaf-700);
  }
  .c-body {
    display: grid;
    gap: 2px;
  }
  .c-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.15;
  }
  .c-text {
    color: var(--ob-gray-500);
    font-size: 0.95rem;
  }
  .c-arrow {
    font-size: 1.3rem;
    transition: transform 0.25s var(--ease);
  }
  .concern-list a:hover .c-arrow {
    transform: translateX(4px);
  }

  /* Producto */
  .showcase-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .showcase-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 80px;
    }
  }
  .showcase-media {
    position: relative;
    display: grid;
    align-content: center;
    aspect-ratio: 1;
    padding: clamp(16px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background: var(--ob-white);
    overflow: hidden;
  }
  .showcase-media :global(.showcase-blob) {
    position: absolute;
    inset: 10% 6%;
    width: 88%;
    height: 80%;
    opacity: 0.55;
  }
  .showcase-media :global(img) {
    position: relative;
    width: 100%;
    mix-blend-mode: multiply;
  }
  .spec {
    position: relative;
    margin-top: 20px;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ob-gray-500);
    text-align: center;
  }
  .showcase-card {
    background: var(--ob-white);
    border: 1px solid var(--ob-line);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: var(--shadow-soft);
  }
  .showcase-card h2 {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
  }
  .benefits {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 0.97rem;
  }
  .benefits li {
    display: flex;
    gap: 12px;
  }
  .benefits strong {
    font-weight: 500;
  }
  .check {
    flex: none;
    position: relative;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--ob-blush-100);
  }
  .check::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 5px;
    width: 5px;
    height: 10px;
    border: solid var(--ob-leaf-700);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .details {
    margin-top: 24px;
  }

  /* Ritual */
  .ritual {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 40px;
    counter-reset: r;
  }
  @media (min-width: 800px) {
    .ritual {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .ritual li + li {
      border-left: 1px solid var(--ob-line);
    }
  }
  .ritual li {
    text-align: center;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .r-n {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 4rem;
    line-height: 1;
    color: var(--ob-blush-500);
    margin-bottom: 16px;
  }

  /* Ingredientes */
  .ingredient {
    text-align: center;
    padding: 12px;
  }
  .ingredient :global(svg) {
    margin: 0 auto 12px;
  }
  .num {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ob-leaf-700);
  }

  /* Tania */
  .founder-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .founder-grid {
      grid-template-columns: 1fr 1fr;
      gap: 112px;
    }
  }
  .collage {
    position: relative;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    padding-bottom: 14%;
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph--main {
    width: 82%;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .ph--small {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    border: 6px solid var(--ob-white);
    box-shadow: var(--shadow-soft);
  }
  .ph--small :global(img) {
    object-position: top;
  }
  .founder-copy .script {
    margin: 4px 0 24px;
  }

  /* Antes y después */
  .ba-placeholder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--ob-line);
    background: var(--ob-white);
  }
  .ba-placeholder span {
    display: grid;
    place-items: end center;
    padding-bottom: 14px;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ob-gray-500);
  }
  .ba-placeholder span + span {
    border-left: 1px solid var(--ob-line);
  }

  .more {
    margin-top: 40px;
  }

  /* Móvil: filas compactas y carruseles deslizables */
  @media (max-width: 799px) {
    .ritual {
      gap: 0;
      border-top: 1px solid var(--ob-line);
    }
    .ritual li {
      display: grid;
      grid-template-columns: 56px 1fr;
      column-gap: 12px;
      text-align: left;
      padding: 20px 0;
      border-bottom: 1px solid var(--ob-line);
    }
    .r-n {
      grid-row: span 2;
      font-size: 2.8rem;
      margin: 0;
    }
    .ritual h3 {
      margin: 0 0 2px;
    }
    .ritual p {
      margin: 0;
    }
    .ingredients {
      gap: 0;
    }
    .ingredient {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 14px;
      text-align: left;
      padding: 18px 0;
      border-bottom: 1px solid rgb(58 31 43 / 0.08);
    }
    .ingredient :global(svg) {
      grid-row: span 3;
      margin: 4px 0 0;
    }
    .ingredient h3,
    .ingredient p {
      margin: 0;
    }
    .swipe {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 12px;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .swipe::-webkit-scrollbar {
      display: none;
    }
    .swipe > :global(*) {
      scroll-snap-align: start;
    }
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .faq-grid {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 96px;
      align-items: start;
    }
  }

  /* Cierre */
  .final {
    overflow: hidden;
  }
  .final-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .final-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 96px;
    }
  }
  .final-media {
    position: relative;
    max-width: 380px;
    width: 100%;
    justify-self: center;
  }
  .final-media :global(img) {
    border-radius: 50%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: var(--shadow-soft);
  }
  .final-media :global(.final-blob) {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    z-index: -1;
  }
  .final-copy :global(svg.leaf-sprig) {
    margin-bottom: 12px;
  }
  .local {
    margin-top: 20px;
    font-size: 0.92rem;
  }
</style>
