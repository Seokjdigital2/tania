---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BuyButtons from '@/components/BuyButtons.astro';
import BlushBlob from '@/components/BlushBlob.astro';
import LeafSprig from '@/components/LeafSprig.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { site } from '@/config/site';
import { product, concerns, formatMXN } from '@/data/product';
import { faqs } from '@/data/faq';
import { reviews } from '@/data/reviews';
import heroImg from '@/assets/img/crema-tocador.jpg';
import viewsImg from '@/assets/img/crema-vistas.jpg';
import taniaBeach from '@/assets/img/tania-playa.jpg';
import taniaUrban from '@/assets/img/tania-urbana.jpg';
import sunsetImg from '@/assets/img/tania-atardecer.jpg';
import productImg from '@/assets/img/crema-producto.jpg';
import zoneFace from '@/assets/img/zona-rostro.jpg';
import zoneArms from '@/assets/img/zona-brazos.jpg';
import zoneLegs from '@/assets/img/zona-piernas.jpg';

// TEXTOS PROVISIONALES: reemplazar con copy final (ver docs/TABLERO.md).
const description = `${site.name}: crema mexicana que ayuda a atenuar la apariencia de manchas en cara, axilas, codos y rodillas. ${product.priceMXN ? formatMXN(product.priceMXN) + '. ' : ''}Creada por Tania en Puerto Vallarta. Compra en Mercado Libre o TikTok Shop.`;
const price = product.priceMXN ? formatMXN(product.priceMXN) : null;

// Zonas del cuerpo (fotos de Tania). Textos PROVISIONALES con lenguaje cosmético.
const zones = [
  {
    tag: 'Rostro',
    title: 'Un rostro de tono uniforme',
    text: 'Ayuda a atenuar la apariencia de manchas por sol, paño y marcas de acné.',
    href: '/manchas-en-la-piel/melasma-y-pano/',
    img: zoneFace,
    alt: 'Rostro de Tania bajo el sol con lentes y gorra',
  },
  {
    tag: 'Brazos y axilas',
    title: 'Brazos y axilas parejos',
    text: 'Para zonas que se oscurecen por el sol, el rasurado o la fricción.',
    href: '/manchas-en-la-piel/axilas-oscuras/',
    img: zoneArms,
    alt: 'Brazo y hombro de Tania con arena de la playa',
  },
  {
    tag: 'Rodillas y piernas',
    title: 'Rodillas y piernas luminosas',
    text: 'Suaviza la apariencia de zonas oscuras por roce en rodillas y codos.',
    href: '/manchas-en-la-piel/codos-y-rodillas-oscuras/',
    img: zoneLegs,
    alt: 'Rodilla de Tania sobre la arena',
  },
];
---

<BaseLayout title={`${site.name} · Crema para manchas en cara y cuerpo`} description={description}>
  <!-- Hero v2: Tania protagonista + tarjeta de producto -->
  <section class="hero2" aria-labelledby="hero-title">
    <div class="hero2-photo">
      <Image
        src={sunsetImg}
        alt="Tania, fundadora de Beauty Organic, en la playa al atardecer sosteniendo su crema"
        widths={[640, 960, 1280, 1672]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero2-inner">
      <div class="hero2-card">
        <div class="hero2-product">
          <Image
            src={productImg}
            alt="Tarro de crema Beauty Organic"
            widths={[240, 400]}
            sizes="(min-width: 1000px) 168px, 132px"
            loading="eager"
          />
        </div>
        <span class="eyebrow">Beauty Organic · Tania</span>
        <h1 id="hero-title">Tu piel sin manchas <span class="h1-sub">Crema para cara y cuerpo</span></h1>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza · envío a todo México</span>
            </p>
          )
        }
        <div id="comprar" data-sticky-trigger>
          <BuyButtons placement="hero" />
        </div>
        <p class="disclaimer">Ayuda a atenuar la apariencia de manchas con uso constante y protector solar. Resultados individuales; pueden variar.</p>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Zonas del cuerpo: Tania como protagonista -->
  <section class="section zones" aria-labelledby="zonas">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">De pies a cabeza</span>
        <h2 id="zonas">Tu piel sin manchas <em>en cara y cuerpo</em></h2>
        <p class="lead">Una sola crema para las zonas donde más se notan las manchas. Tania la usa todos los días bajo el sol de Puerto Vallarta.</p>
      </div>
      <ul class="zone-grid">
        {
          zones.map((z) => (
            <li>
              <a href={z.href} class="zone">
                <div class="zone-ph">
                  <Image src={z.img} alt={z.alt} widths={[360, 600]} sizes="(min-width: 900px) 360px, 84vw" />
                </div>
                <span class="zone-tag">{z.tag}</span>
                <h3>{z.title}</h3>
                <p class="muted">{z.text}</p>
                <span class="link-arrow">Ver guía →</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="zones-cta" data-sticky-trigger>
        <BuyButtons placement="showcase" />
      </div>
    </div>
  </section>

  <!-- Tania -->
  <section class="section founder">
    <div class="container founder-grid">
      <div class="collage">
        <div class="ph ph--main">
          <Image
            src={taniaBeach}
            alt="Tania, fundadora de Beauty Organic, en una playa de Puerto Vallarta sosteniendo su crema"
            widths={[400, 600, 784]}
            sizes="(min-width: 1000px) 440px, 78vw"
          />
        </div>
        <div class="ph ph--small">
          <Image
            src={taniaUrban}
            alt="Tania sosteniendo un tarro de Beauty Organic"
            widths={[240, 400]}
            sizes="(min-width: 1000px) 220px, 40vw"
          />
        </div>
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Conoce a la fundadora</span>
        <h2>Hola, <em>soy Tania</em></h2>
        <p class="lead">
          Texto provisional: aquí Tania cuenta en dos o tres líneas por qué creó Beauty Organic y qué la hace diferente.
        </p>
        <p class="script">Belleza que realza tu esencia</p>
        <a class="link-arrow" href="/sobre-tania/">Lee mi historia →</a>
      </div>
    </div>
  </section>

  <!-- Producto -->
  <section class="section section--ivory showcase" aria-labelledby="la-crema">
    <div class="container showcase-grid">
      <div class="showcase-media">
        <BlushBlob class="showcase-blob" />
        <Image
          src={viewsImg}
          alt="Tarro de crema Beauty Organic visto de frente, desde arriba y de lado"
          widths={[600, 900, 1230]}
          sizes="(min-width: 1000px) 640px, 92vw"
        />
        <p class="spec">Tarro de {product.container.diameterCm} cm × {product.container.heightCm} cm · {product.netContent || 'contenido por confirmar'}</p>
      </div>
      <div class="showcase-card">
        <span class="eyebrow">La crema</span>
        <h2 id="la-crema">{product.shortName}</h2>
        <p class="muted">{product.description}</p>
        <ul class="benefits">
          {
            product.benefits.map((b) => (
              <li>
                <span class="check" aria-hidden="true" />
                <span><strong>{b.title}.</strong> {b.text}</span>
              </li>
            ))
          }
        </ul>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza</span>
            </p>
          )
        }
        <div data-sticky-trigger><BuyButtons placement="pdp" class="buy--stack" /></div>
        <a class="link-arrow details" href="/crema-desmanchadora/">Ver detalles, ingredientes y modo de uso →</a>
      </div>
    </div>
  </section>

  <!-- Ritual -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">El ritual</span>
        <h2>Tres pasos, <em>todos los días</em></h2>
      </div>
      <ol class="ritual">
        {
          product.howToUse.map((s, n) => (
            <li>
              <span class="r-n">{n + 1}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Tipos de manchas (editorial) -->
  <section class="section">
    <div class="container concerns">
      <div class="concerns-head">
        <span class="eyebrow">Tu piel, tu historia</span>
        <h2>¿Qué manchas <em>te preocupan?</em></h2>
        <p class="lead">Cada mancha tiene una causa distinta. Conócela para cuidarla mejor.</p>
        <a class="link-arrow" href="/manchas-en-la-piel/">Ver todas las guías →</a>
      </div>
      <ol class="concern-list">
        {
          concerns.map((c, i) => (
            <li>
              <a href={`/manchas-en-la-piel/${c.slug}/`}>
                <span class="n">0{i + 1}</span>
                <span class="c-body">
                  <span class="c-title">{c.title}</span>
                  <span class="c-text">{c.text}</span>
                </span>
                <span class="c-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Ingredientes -->
  <section class="section section--blush ingredients-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">La fórmula</span>
        <h2>Ingredientes que <em>cuidan tu piel</em></h2>
      </div>
      <div class="grid grid--3 ingredients">
        {
          product.keyIngredients.map((i, n) => (
            <div class="ingredient">
              <LeafSprig size={38} />
              <span class="num">0{n + 1}</span>
              <h3>{i.name}</h3>
              <p class="muted">{i.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Antes y después: espacio reservado -->
  <section class="section section--ivory">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Resultados reales</span>
        <h2>Antes <em>y después</em></h2>
        <p class="lead">Aquí mostraremos fotos reales de clientas, con su permiso. Resultados individuales; pueden variar.</p>
      </div>
      <div class="grid grid--3 swipe">
        {
          [1, 2, 3].map((n) => (
            <div class="ba-placeholder" role="img" aria-label={`Espacio reservado para foto de antes y después ${n}`}>
              <span>Antes</span>
              <span>Después</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Reseñas -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Opiniones</span>
        <h2>Lo que dicen <em>nuestras clientas</em></h2>
      </div>
      <div class="grid grid--3 swipe">
        {reviews.slice(0, 3).map((r) => <ReviewCard review={r} />)}
      </div>
      <p class="center more"><a class="link-arrow" href="/resenas/">Ver todas las reseñas →</a></p>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section section--ivory">
    <div class="container faq-grid">
      <div class="faq-head">
        <span class="eyebrow">Dudas</span>
        <h2>Preguntas <em>frecuentes</em></h2>
        <p class="muted">¿No encuentras tu respuesta? <a href="/preguntas-frecuentes/">Ver todas las preguntas</a>.</p>
      </div>
      <FaqAccordion items={faqs.slice(0, 6)} />
    </div>
  </section>

  <!-- Cierre -->
  <section class="section final">
    <div class="container final-grid">
      <div class="final-media">
        <BlushBlob class="final-blob" />
        <Image src={heroImg} alt="" widths={[360, 600]} sizes="(min-width: 1000px) 380px, 70vw" />
      </div>
      <div class="final-copy">
        <LeafSprig size={52} />
        <h2>Tu piel sin manchas <em>empieza hoy</em></h2>
        {
          price && (
            <p class="price-tag">
              <strong>{price}</strong>
              <span>por pieza · envío a todo México</span>
            </p>
          )
        }
        <div data-sticky-trigger><BuyButtons placement="final" note /></div>
        <p class="muted local">
          ¿Estás en {site.delivery.area}? <a href="/entrega-puerto-vallarta/">Conoce la entrega local por motocicleta</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero v2 */
  .hero2 {
    position: relative;
    display: grid;
    background: var(--ob-ivory);
  }
  .hero2-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 22% 50%;
  }
  .hero2-card {
    position: relative;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3.4vw, 44px);
    box-shadow: 0 30px 60px -30px rgb(51 34 30 / 0.45);
  }
  .hero2-product {
    width: 168px;
    aspect-ratio: 1;
    margin-bottom: 20px;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid var(--ob-white);
    box-shadow: 0 16px 32px -18px rgb(51 34 30 / 0.5);
  }
  .hero2-product :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero2 h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    margin-bottom: 0.4em;
  }
  .h1-sub {
    display: block;
    margin-top: 10px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ob-mocha);
  }
  .hero2 .price-tag strong {
    color: var(--ob-plum-700);
  }
  .disclaimer {
    margin: 14px 0 0;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--ob-gray-500);
  }
  @media (min-width: 1000px) {
    .hero2 {
      min-height: min(86vh, 820px);
    }
    .hero2-photo {
      position: absolute;
      inset: 0;
    }
    .hero2-photo::after {
      /* Velo cálido a la derecha para que la tarjeta respire sobre el mar. */
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 45%, rgb(248 242 236 / 0.35) 100%);
    }
    .hero2-inner {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-block: 56px;
    }
    .hero2-card {
      width: min(460px, 42%);
    }
  }
  @media (max-width: 999px) {
    .hero2-photo {
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }
    .hero2-photo :global(img) {
      object-position: 18% 50%;
    }
    .hero2-inner {
      margin-top: -72px;
      padding-bottom: 32px;
    }
    .hero2-card {
      text-align: center;
      background: var(--ob-white);
    }
    .hero2-product {
      width: 112px;
      margin: -76px auto 14px;
    }
    .hero2 .price-tag {
      justify-content: center;
    }
  }

  /* Zonas del cuerpo */
  .zone-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .zone-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .zone {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .zone-ph {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
    margin-bottom: 20px;
    background: var(--ob-blush-100);
  }
  .zone-ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .zone:hover .zone-ph :global(img) {
    transform: scale(1.04);
  }
  .zone-tag {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ob-mocha);
    font-weight: 500;
  }
  .zone h3 {
    margin: 8px 0 6px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
  }
  .zone p {
    flex: 1;
  }
  .zone .link-arrow {
    align-self: flex-start;
  }
  .zones-cta {
    max-width: 760px;
    margin: clamp(48px, 6vw, 72px) auto 0;
  }
  @media (max-width: 899px) {
    .zone-grid {
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 8px;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .zone-grid::-webkit-scrollbar {
      display: none;
    }
    .zone-grid > li {
      scroll-snap-align: start;
    }
  }

  /* Manchas */
  .concerns {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .concerns {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 96px;
      align-items: start;
    }
    .concerns-head {
      position: sticky;
      top: 140px;
    }
  }
  .concern-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ob-line);
  }
  .concern-list li {
    border-bottom: 1px solid var(--ob-line);
  }
  .concern-list a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 28px 4px;
    text-decoration: none;
    transition: background-color 0.25s var(--ease);
  }
  .concern-list a:hover {
    background: var(--ob-ivory);
  }
  .n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ob-leaf-700);
  }
  .c-body {
    display: grid;
    gap: 2px;
  }
  .c-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.15;
  }
  .c-text {
    color: var(--ob-gray-500);
    font-size: 0.95rem;
  }
  .c-arrow {
    font-size: 1.3rem;
    transition: transform 0.25s var(--ease);
  }
  .concern-list a:hover .c-arrow {
    transform: translateX(4px);
  }

  /* Producto */
  .showcase-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .showcase-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 80px;
    }
  }
  .showcase-media {
    position: relative;
    display: grid;
    align-content: center;
    aspect-ratio: 1;
    padding: clamp(16px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background: var(--ob-white);
    overflow: hidden;
  }
  .showcase-media :global(.showcase-blob) {
    position: absolute;
    inset: 10% 6%;
    width: 88%;
    height: 80%;
    opacity: 0.55;
  }
  .showcase-media :global(img) {
    position: relative;
    width: 100%;
    mix-blend-mode: multiply;
  }
  .spec {
    position: relative;
    margin-top: 20px;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ob-gray-500);
    text-align: center;
  }
  .showcase-card {
    background: var(--ob-white);
    border: 1px solid var(--ob-line);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: var(--shadow-soft);
  }
  .showcase-card h2 {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
  }
  .benefits {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 0.97rem;
  }
  .benefits li {
    display: flex;
    gap: 12px;
  }
  .benefits strong {
    font-weight: 500;
  }
  .check {
    flex: none;
    position: relative;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--ob-blush-100);
  }
  .check::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 5px;
    width: 5px;
    height: 10px;
    border: solid var(--ob-leaf-700);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .details {
    margin-top: 24px;
  }

  /* Ritual */
  .ritual {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 40px;
    counter-reset: r;
  }
  @media (min-width: 800px) {
    .ritual {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .ritual li + li {
      border-left: 1px solid var(--ob-line);
    }
  }
  .ritual li {
    text-align: center;
    padding-inline: clamp(16px, 3vw, 48px);
  }
  .r-n {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 4rem;
    line-height: 1;
    color: var(--ob-blush-500);
    margin-bottom: 16px;
  }

  /* Ingredientes */
  .ingredient {
    text-align: center;
    padding: 12px;
  }
  .ingredient :global(svg) {
    margin: 0 auto 12px;
  }
  .num {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ob-leaf-700);
  }

  /* Tania */
  .founder-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1000px) {
