---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlushBlob from '@/components/BlushBlob.astro';
import LeafSprig from '@/components/LeafSprig.astro';
import { site, absoluteUrl } from '@/config/site';
import { founderSchema, ids } from '@/lib/schema';
import taniaImg from '@/assets/img/tania-playa.jpg';
import taniaUrban from '@/assets/img/tania-urbana.jpg';

const title = 'Sobre Tania, fundadora de Beauty Organic';
const description = 'Conoce a Tania, creadora de Beauty Organic en Puerto Vallarta: su historia, su propósito y por qué creó una crema para cara y cuerpo.';
const schema = [
  founderSchema(),
  { '@type': 'AboutPage', '@id': absoluteUrl('/sobre-tania/#page'), name: title, mainEntity: { '@id': ids.founder } },
];
---

<BaseLayout title={title} description={description} ogImage="/og/tania.jpg" schema={schema}>
  <Breadcrumbs items={[{ name: 'Sobre Tania', href: '/sobre-tania/' }]} />

  <section class="section">
    <div class="container about">
      <div class="media">
        <BlushBlob class="about-blob" />
        <Image
          src={taniaImg}
          alt="Tania, fundadora de Beauty Organic, en una playa de Puerto Vallarta sosteniendo su crema"
          widths={[400, 600, 784]}
          sizes="(min-width: 900px) 460px, 86vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="prose">
        <span class="eyebrow">La fundadora</span>
        <h1>Hola, <em>soy Tania</em></h1>
        <p class="lead">
          Texto provisional: una frase que resuma quién es Tania y qué la mueve.
        </p>
        <h2>Cómo nació Beauty Organic</h2>
        <p>
          Texto provisional: aquí va la historia real de Tania. Qué problema vivió con su piel o la de alguien cercano, qué buscaba y
          no encontraba, y cómo decidió crear su propia crema en {site.location.city}.
        </p>
        <figure class="inline-photo">
          <Image
            src={taniaUrban}
            alt="Tania sosteniendo un tarro de Beauty Organic"
            widths={[360, 560]}
            sizes="(min-width: 900px) 320px, 70vw"
          />
          <figcaption>Tania con Beauty Organic</figcaption>
        </figure>
        <h2>Mi propósito</h2>
        <p>
          Texto provisional: qué quiere lograr con la marca, qué valores la guían (honestidad, cuidado, cercanía) y qué significa
          para ella “belleza que realza tu esencia”.
        </p>
        <blockquote>
          <p class="script">Belleza que realza tu esencia</p>
        </blockquote>
        <h2>Por qué confiar en nosotras</h2>
        <ul>
          <li>Texto provisional: diferenciador 1.</li>
          <li>Texto provisional: diferenciador 2.</li>
          <li>Texto provisional: diferenciador 3.</li>
        </ul>
        <p><a class="link-arrow" href="/crema-desmanchadora/">Conoce la crema →</a></p>
      </div>
    </div>
  </section>
  <div class="center leaf"><LeafSprig size={48} /></div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: clamp(48px, 7vw, 112px);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .media {
      position: sticky;
      top: 110px;
    }
  }
  .media {
    position: relative;
    max-width: 460px;
    justify-self: center;
  }
  .media :global(img) {
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }
  .media :global(.about-blob) {
    position: absolute;
    inset: -6% -12%;
    width: 124%;
    height: 112%;
    z-index: -1;
  }
  .inline-photo {
    margin: 40px 0;
    max-width: 320px;
  }
  .inline-photo :global(img) {
    border-radius: var(--radius);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ob-gray-500);
  }
  .prose .script {
    margin: 0;
  }
  .leaf {
    padding-bottom: 64px;
  }
  .leaf :global(svg) {
    margin-inline: auto;
  }
</style>
