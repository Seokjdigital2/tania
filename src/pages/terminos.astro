---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/config/site';
const title = 'Términos y condiciones';
---

<BaseLayout title={title} description={`Términos y condiciones de uso del sitio de ${site.name}.`} stickyBuy={false}>
  <Breadcrumbs items={[{ name: title, href: '/terminos/' }]} />
  <section class="section">
    <div class="container prose">
      <h1>{title}</h1>
      <p class="muted"><strong>Plantilla provisional.</strong> Debe revisarse antes del lanzamiento.</p>
      <h2>Uso del sitio</h2>
      <p>Este sitio es informativo. Las compras se realizan en Mercado Libre y TikTok Shop, sujetas a los términos de cada plataforma.</p>
      <h2>Información del producto</h2>
      <p>{site.name} es un producto cosmético. La información de este sitio no sustituye la consulta con un profesional de la salud. Los resultados pueden variar de persona a persona.</p>
      <h2>Propiedad intelectual</h2>
      <p>La marca, el logotipo, los textos y las imágenes pertenecen a {site.legalName}.</p>
    </div>
  </section>
</BaseLayout>
