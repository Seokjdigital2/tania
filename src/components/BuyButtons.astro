---
/**
 * Botones de compra hacia Mercado Libre y TikTok Shop.
 * Usan los colores de cada plataforma para que se reconozcan al instante.
 * Si el enlace aún no existe en src/config/site.ts, el botón conserva su color
 * pero queda desactivado con la etiqueta "Muy pronto".
 */
import { site, buyPlatforms, type BuyPlatform } from '@/config/site';

interface Props {
  placement: 'hero' | 'sticky' | 'pdp' | 'final' | 'article' | 'showcase';
  compact?: boolean;
  /** Muestra la nota de compra protegida debajo de los botones. */
  note?: boolean;
  class?: string;
}

const { placement, compact = false, note = false, class: className = '' } = Astro.props;
const order: BuyPlatform[] = ['mercadolibre', 'tiktokshop'];
const pending = !(site.buy.mercadolibre && site.buy.tiktokshop);

const buttons = order.map((platform) => {
  const href: string = site.buy[platform];
  const attrs: Record<string, string | boolean> = href
    ? { href, rel: 'noopener', 'data-buy': platform, 'data-placement': placement }
    : { type: 'button', disabled: true, 'aria-describedby': `soon-${placement}` };
  return { platform, href, short: buyPlatforms[platform].short, Tag: (href ? 'a' : 'button') as any, attrs };
});
---

<div class:list={['buy', { 'buy--compact': compact }, className]}>
  <div class="buy-group">
    {
      buttons.map(({ platform, href, short, Tag, attrs }) => {
        return (
          <Tag class:list={['mk', `mk--${platform}`]} data-platform={platform} {...attrs}>
            <span class="mk-icon" aria-hidden="true">
              {platform === 'tiktokshop' ? (
                <svg viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                </svg>
              ) : (
                <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="16" cy="12" rx="14.5" ry="10.5" />
                  <path d="M5.5 11.5 9 9l3.5 1.8L16 8.5l3.5 2.3L23 9l3.5 2.5" />
                  <path d="m10.5 13.5 2.2 2 2-1.3 2 1.6 2-1.3 2.4 1.5" />
                </svg>
              )}
            </span>
            <span class="mk-text">
              {!compact && <small>Comprar en</small>}
              <strong>{short}</strong>
            </span>
            {href ? (
              <span class="mk-arrow" aria-hidden="true">→</span>
            ) : (
              <span class="mk-soon">Muy pronto</span>
            )}
          </Tag>
        );
      })
    }
  </div>
  {
    note && (
      <p class="buy-note">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        {pending ? 'Tiendas oficiales disponibles muy pronto' : 'Pago protegido dentro de Mercado Libre y TikTok Shop'}
      </p>
    )
  }
  {pending && <span id={`soon-${placement}`} class="sr-only">Las tiendas en línea se activarán muy pronto.</span>}
</div>

<style>
  /* Los botones se colocan lado a lado solo si su contenedor tiene espacio suficiente. */
  .buy {
    container-type: inline-size;
  }
  .buy-group {
    display: grid;
    gap: 12px;
  }
  @container (min-width: 580px) {
    .buy:not(.buy--stack) .buy-group {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mk {
    --mk-bg: #ffe600;
    --mk-fg: #2d3277;
    --mk-hover: #f2d900;
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 10px 18px 10px 16px;
    border: 0;
    border-radius: 10px;
    background: var(--mk-bg);
    color: var(--mk-fg);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 10px 24px -14px rgb(0 0 0 / 0.45);
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .mk--tiktokshop {
    --mk-bg: #111111;
    --mk-fg: #ffffff;
    --mk-hover: #000000;
  }
  a.mk:hover {
    background: var(--mk-hover);
    transform: translateY(-1px);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 16px 30px -14px rgb(0 0 0 / 0.5);
  }
  a.mk:active {
    transform: translateY(0);
  }
  .mk[disabled] {
    cursor: not-allowed;
  }

  .mk-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
  }
  .mk--tiktokshop .mk-icon {
    background: rgb(255 255 255 / 0.08);
  }
  .mk-icon svg {
    width: 22px;
    height: 22px;
  }
  .mk--tiktokshop .mk-icon svg {
    width: 18px;
    fill: #fff;
    filter: drop-shadow(1.5px 1px 0 #fe2c55) drop-shadow(-1.5px -1px 0 #25f4ee);
  }

  .mk-text {
    display: grid;
    flex: 1;
    line-height: 1.15;
  }
  .mk-text small {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .mk-text strong {
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .mk-arrow {
    font-size: 1.2rem;
    transition: transform 0.2s var(--ease);
  }
  a.mk:hover .mk-arrow {
    transform: translateX(3px);
  }
  .mk-soon {
    flex: none;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--mk-fg);
    color: var(--mk-bg);
  }

  /* Versión compacta (barra fija en móvil) */
  .buy--compact .buy-group,
  .buy--compact:not(.buy--stack) .buy-group {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .buy--compact .mk {
    min-height: 50px;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
  }
  .buy--compact .mk-icon {
    width: 26px;
    height: 26px;
  }
  .buy--compact .mk-icon svg {
    width: 18px;
    height: 18px;
  }
  .buy--compact .mk-text strong {
    font-size: 0.9rem;
  }
  .buy--compact .mk-soon,
  .buy--compact .mk-arrow {
    display: none;
  }

  .buy-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 0.82rem;
    color: var(--ob-gray-500);
  }
  .buy-note svg {
    flex: none;
    color: var(--ob-leaf-700);
  }

  /* En el navegador interno de TikTok se prioriza TikTok Shop. */
  :global(html[data-inapp='tiktok']) [data-platform='tiktokshop'] {
    order: -1;
  }
</style>
