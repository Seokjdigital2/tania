---
/** Mancha rosa acuarela del logotipo. Decorativa (aria-hidden). */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class:list={['blush-blob', className]} viewBox="0 0 600 520" aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <defs>
    <radialGradient id="blushFill" cx="45%" cy="45%" r="65%">
      <stop offset="0%" stop-color="var(--ob-blush-300)" stop-opacity=".95"></stop>
      <stop offset="70%" stop-color="var(--ob-blush-300)" stop-opacity=".75"></stop>
      <stop offset="100%" stop-color="var(--ob-blush-100)" stop-opacity=".4"></stop>
    </radialGradient>
  </defs>
  <path
    fill="url(#blushFill)"
    d="M318 22c86-6 196 34 244 112 44 72 30 168-14 236-46 72-132 128-228 138-104 10-218-26-276-104C-6 334-8 230 36 154 82 76 214 30 318 22Z"
  ></path>
</svg>
