---
import { Image } from 'astro:assets';
import { nav, site } from '@/config/site';
import { product, formatMXN } from '@/data/product';
import logo from '@/assets/img/logo-wordmark.png';

const path = Astro.url.pathname;
---

<div class="announce">
  <div class="container announce-inner">
    <p>
      <span>Envíos a todo México</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>Entrega en {site.delivery.area}</span>
      {product.priceMXN && (
        <>
          <span class="sep hide-sm" aria-hidden="true">·</span>
          <span class="hide-sm">{formatMXN(product.priceMXN)} por pieza</span>
        </>
      )}
    </p>
    {site.prelaunch && <p class="pre">Sitio en construcción · textos provisionales</p>}
  </div>
</div>

<header class="site-header" data-header>
  <div class="container bar">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Abrir menú</span>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>

    <nav class="nav" aria-label="Principal">
      <ul id="menu" data-menu>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="menu-extra"><a href="/entrega-puerto-vallarta/">Entrega en Puerto Vallarta</a></li>
        <li class="menu-extra"><a href="/resenas/">Reseñas</a></li>
      </ul>
    </nav>

    <a href="/" class="brand" aria-label={`${site.name}, inicio`}>
      <Image src={logo} alt={site.signature} width={110} height={86} loading="eager" fetchpriority="high" />
    </a>

    <div class="actions">
      <a class="delivery-link" href="/entrega-puerto-vallarta/">Entrega local</a>
      <a class="btn buy-cta" href="/crema-desmanchadora/#comprar">
        Comprar{product.priceMXN && <span class="cta-price"> · ${product.priceMXN}</span>}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const close = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('is-open');
    document.body.style.overflow = '';
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) return close();
    toggle.setAttribute('aria-expanded', 'true');
    header?.classList.add('is-open');
    const nav = header?.querySelector<HTMLElement>('.nav');
    if (nav && header) nav.style.height = `${window.innerHeight - header.getBoundingClientRect().bottom}px`;
    document.body.style.overflow = 'hidden';
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
  document.querySelectorAll('[data-menu] a').forEach((a) => a.addEventListener('click', close));
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .announce {
    background: var(--ob-plum-900);
    color: var(--ob-white);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .announce-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 24px;
    padding-block: 9px;
    text-align: center;
  }
  .announce p {
    margin: 0;
  }
  .sep {
    margin-inline: 10px;
    opacity: 0.6;
  }
  .pre {
    color: var(--ob-blush-300);
  }
  @media (max-width: 599px) {
    .hide-sm {
      display: none;
    }
    .announce {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .announce-inner {
      padding-block: 7px;
    }
    .pre {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--ob-line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    min-height: 96px;
    transition: min-height 0.25s var(--ease);
  }
  .site-header:global(.is-scrolled) .bar {
    min-height: 72px;
  }
  .brand {
    grid-column: 2;
    grid-row: 1;
    display: block;
  }
  .brand img {
    width: 110px;
    height: auto;
    transition: width 0.25s var(--ease);
  }
  .site-header:global(.is-scrolled) .brand img {
    width: 84px;
  }
  .nav {
    grid-column: 1;
    grid-row: 1;
  }
  .nav ul {
    display: flex;
    gap: clamp(18px, 2.4vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .delivery-link {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .nav a:hover,
  .nav a[aria-current='page'],
  .delivery-link:hover {
    border-bottom-color: var(--ob-plum-900);
  }
  .menu-extra {
    display: none;
  }
  .actions {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
  }
  .buy-cta {
    min-height: 44px;
    padding: 0.6em 1.3em;
  }
  .cta-price {
    letter-spacing: 0.06em;
  }
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: -10px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 7px;
    width: 24px;
    margin: auto;
  }
  .bars span {
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s var(--ease);
  }
  .site-header:global(.is-open) .bars span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  .site-header:global(.is-open) .bars span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  @media (max-width: 999px) {
    .bar,
    .site-header:global(.is-scrolled) .bar {
      min-height: 68px;
    }
    .brand img,
    .site-header:global(.is-scrolled) .brand img {
      width: 74px;
    }
    .menu-toggle {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }
    .delivery-link,
    .cta-price {
      display: none;
    }
    .buy-cta {
      min-height: 40px;
      padding: 0.5em 1em;
      font-size: 0.7rem;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - 68px);
      border-top: 1px solid var(--ob-line);
      overflow-y: auto;
      background: var(--ob-white);
      padding: 16px var(--gutter) 40px;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0.25s;
    }
    .site-header:global(.is-open) .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav li {
      border-bottom: 1px solid var(--ob-line);
    }
    .nav a {
      display: block;
      padding-block: 20px;
      font-family: var(--font-serif);
      font-size: 1.75rem;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      border: 0;
    }
    .menu-extra {
      display: block;
    }
  }
</style>
